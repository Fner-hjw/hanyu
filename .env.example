# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Leave empty to run without cloud sync (progress stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public contact shown on /privacy and /terms (needed for Google OAuth verification).
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Search Console "HTML tag" code (only the content="..." value).
GOOGLE_SITE_VERIFICATION=
